RewriteEngine On

# Redirect /index or /index.php to root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index(\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirect old blog page URLs to new clean URLs
RewriteRule ^blog/pages/blog__(.+?)(\.php)?$ /blog/$1 [R=301,L,NC]

# Externally redirect /foo.php to /foo (clean URLs)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L,NE]

# Internally rewrite /foo to /foo.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
